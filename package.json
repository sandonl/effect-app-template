{
  "name": "app-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "cloudflare:dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@repo/api",
    "dev:web": "turbo run dev --filter=@repo/web",
    "destroy": "alchemy destroy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint alchemy.run.ts infrastructure && turbo run lint",
    "lint:fix": "oxlint --fix .",
    "plan": "alchemy plan",
    "test": "turbo run test",
    "typecheck": "tsc --noEmit --project tsconfig.infra.json && turbo run typecheck"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
