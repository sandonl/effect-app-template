{
  "name": "app-template",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@alchemy.run/cloudflare": "2.0.0-beta.84",
      "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
      "@base-ui/react": "1.9.0",
      "@effect/atom-react": "4.0.6",
      "@effect/platform-browser": "4.0.6",
      "@effect/platform-bun": "4.0.6",
      "@effect/platform-node": "4.0.6",
      "@effect/tsgo": "0.62.0",
      "@effect/vitest": "4.0.6",
      "@oxlint/plugins": "1.90.0",
      "@types/node": "26.6.5",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.2",
      "alchemy": "2.0.0-beta.84",
      "effect": "4.0.6",
      "oxlint": "1.90.0",
      "oxlint-tsgolint": "7.0.2005",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "scheduler": "0.28.0",
      "tsup": "9.0.0",
      "tsx": "4.23.15",
      "turbo": "2.11.10",
      "typescript": "7.0.2",
      "vite": "8.3.5",
      "vitest": "5.0.5"
    }
  },
  "overrides": {
    "effect": "catalog:",
    "@effect/atom-react": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "engines": {
    "bun": ">=1.4.4",
    "node": "^22.22.3 || ^24.11.1 || >=26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "cloudflare:dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@repo/api",
    "dev:web": "turbo run dev --filter=@repo/web",
    "destroy": "alchemy destroy",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint alchemy.run.ts infrastructure && turbo run lint",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix .",
    "plan": "alchemy plan",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "test": "bun run test:lint-rules && turbo run test",
    "test:lint-rules": "node --test tools/oxlint/anti-slop/tests/*.test.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.infra.json && turbo run typecheck"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
